[flake8]
max-line-length = 100
extend-exclude = .venv,mutants,build,dist
per-file-ignores =
    tests/*: E501
    # Legacy plotting module predates the linter gate; restyling it is out
    # of scope for the audit PR. All other files are held to full strictness.
    strom/plot_utils.py: E501,W291,W292,W293,E127,E128,E251,E301,E302,E303,E225,E222
